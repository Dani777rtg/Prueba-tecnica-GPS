{
  "info": {
    "name": "Fleet GPS Telemetry API",
    "description": "Colección para probar casos exitosos y TODOS los manejos de error del backend.\n\n1) Ejecuta primero Auth → Login (guarda el token automáticamente).\n2) Corre las carpetas de errores.\n\nVariables: baseUrl, adminEmail, adminPassword, accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://fleet-gps-api.onrender.com" },
    { "key": "adminEmail", "value": "admin@fleet.local" },
    { "key": "adminPassword", "value": "FleetAdmin123!" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health — 200 OK",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "GET /ruta-inexistente — 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/no-existe"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST /auth/login — 200 OK (guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.access_token).to.be.a('string');",
                  "pm.collectionVariables.set('accessToken', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login — 400 falta email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"FleetAdmin123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login — 400 falta password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fleet.local\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login — 400 email inválido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-email\",\n  \"password\": \"FleetAdmin123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login — 400 password corta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fleet.local\",\n  \"password\": \"corta\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login — 400 campos extra (DTO estricto)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fleet.local\",\n  \"password\": \"FleetAdmin123!\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/login — 401 credenciales inválidas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fleet.local\",\n  \"password\": \"PasswordIncorrecta1\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "GET /auth/me — 200 OK",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "GET /auth/me — 401 sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "GET /auth/me — 401 token basura",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer token-invalido" }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. POST /gps — éxito",
      "item": [
        {
          "name": "POST /gps — 201 OK",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"VH-POSTMAN\",\n  \"lat\": 4.711,\n  \"lng\": -74.0721,\n  \"timestamp\": \"2026-07-27T20:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/gps"
          }
        },
        {
          "name": "POST /gps — 401 sin token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"VH-POSTMAN\",\n  \"lat\": 4.711,\n  \"lng\": -74.0721,\n  \"timestamp\": \"2026-07-27T20:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/gps"
          }
        }
      ]
    },
